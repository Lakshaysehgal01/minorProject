PORT=4000
# Required. e.g. mongodb://127.0.0.1:27017/microgrid or an Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/microgrid


ML_SERVICE_URL=http://localhost:8000
# xgboost | lightgbm | catboost  (lstm/ensemble need a 24-row history payload and are not supported here)
# ML_MODEL=lightgbm
# Optional per-target overrides (default to ML_MODEL)
# ML_MODEL_SOLAR=lightgbm
# ML_MODEL_CONSUMPTION=xgboost


# Paths are resolved relative to /backend (where npm scripts run)
ML_RESULTS_DIR=../ml-service/results
DATA_CSV_PATH=../ml-service/data/energy_data.csv


RPC_URL=http://127.0.0.1:8545
# Hardhat account #0 (publicly known key; local node only, NEVER use on a real network)
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Optional: overrides the address written by `npm run deploy` into src/contracts/EnergyTrading.json
CONTRACT_ADDRESS=


# Prices per kWh. Must satisfy GRID_PRICE > P2P_PRICE_PER_KWH > FEEDIN_PRICE > 0
P2P_PRICE_PER_KWH=6
GRID_PRICE=8
FEEDIN_PRICE=3
# A household is only a seller/buyer if its predicted surplus/deficit exceeds this (kWh)
MIN_KWH=0.5


# Comma-separated allowed origins (React dev server)
CORS_ORIGIN=http://localhost:5173



